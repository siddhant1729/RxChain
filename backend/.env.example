# HTTP port for the API
PORT=4000
# JSON-RPC endpoint of the chain (Hardhat node default; Ganache: http://127.0.0.1:7545)
RPC_URL=http://127.0.0.1:8545
# Public URL of the frontend — encoded in QR codes as ${PUBLIC_APP_URL}/verify/<batchId>.
# Use your LAN IP (e.g. http://192.168.1.20:5173) so a phone camera can open it.
PUBLIC_APP_URL=http://localhost:5173
# Allowed CORS origin(s), comma separated, or * for any
CORS_ORIGIN=*
# Generated by `npm run deploy` (leave empty for the default backend/src/contracts/RxChain.json)
CONTRACT_FILE=
# SQLite database (event index + document metadata)
DATABASE_FILE=./data/rxchain.db
# Directory where uploaded documents are stored
UPLOADS_DIR=./uploads
# Reference documents imported into the document store at startup (demo CoA PDFs)
SAMPLES_DIR=../samples
# Max upload size in MB
MAX_UPLOAD_MB=10
# Block polling interval for the event indexer (ms)
INDEXER_POLL_MS=1000
