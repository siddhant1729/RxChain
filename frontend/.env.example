# Backend API base URL. Leave empty to use http://<current-host>:4000 (works from a phone on your LAN)
VITE_API_URL=
# JSON-RPC used for read-only dashboard queries. Leave empty for http://<current-host>:8545
VITE_RPC_URL=
# RPC URL MetaMask is asked to add for the Hardhat network
VITE_WALLET_RPC_URL=http://127.0.0.1:8545
# Optional block explorer base URL (e.g. https://sepolia.etherscan.io). Empty = built-in /tx page
VITE_EXPLORER_URL=
